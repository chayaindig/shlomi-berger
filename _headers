# Cache rules for Cloudflare (Chaya, 17.11). Built files have a hash in their name, so they can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Photos and icons keep their names when replaced, so a day, then refreshed in the background
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
